# Provider modes
DRAMA_PLUGIN_PROVIDER_MEMORY_MODE=mock
DRAMA_PLUGIN_PROVIDER_ASSET_MODE=mock
DRAMA_PLUGIN_PROVIDER_RESEARCH_MODE=mock
DRAMA_PLUGIN_PROVIDER_PRODUCTION_MODE=mock
DRAMA_PLUGIN_PROVIDER_MEDIA_MODE=mock
DRAMA_PLUGIN_PROVIDER_CONTEXT_MODE=local

# Optional real speech provider. Select exactly one adapter; no provider
# fallback occurs. Real calls also require the explicit REAL_TTS_E2E=true gate.
DRAMA_PLUGIN_PROVIDER_SPEECH_MODE=disabled
# OPENAI_API_KEY=change-me
# DASHSCOPE_API_KEY=change-me
# DRAMA_PLUGIN_SERVICE_SPEECH_OPENAI_BASE_URL=https://api.openai.com/v1
# DRAMA_PLUGIN_SERVICE_SPEECH_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# DRAMA_PLUGIN_SERVICE_SPEECH_OUTPUT_DIRECTORY=/absolute/path/to/artifacts/batch7-2/review
# DRAMA_PLUGIN_SERVICE_SPEECH_TIMEOUT_SECONDS=30
# DRAMA_PLUGIN_SERVICE_SPEECH_MAX_TRANSIENT_RETRIES=2
# REAL_TTS_E2E=false

# Real Drama Service example. These three providers are independent and all
# three API_TOKEN values must equal the Java DRAMA_TOOL_SECRET.
# DRAMA_PLUGIN_PROVIDER_MEMORY_MODE=http
# DRAMA_PLUGIN_SERVICE_MEMORY_BASE_URL=http://127.0.0.1:8080
# DRAMA_PLUGIN_SERVICE_MEMORY_API_TOKEN=change-me
# DRAMA_PLUGIN_PROVIDER_ASSET_MODE=http
# DRAMA_PLUGIN_SERVICE_ASSET_BASE_URL=http://127.0.0.1:8080
# DRAMA_PLUGIN_SERVICE_ASSET_API_TOKEN=change-me
# DRAMA_PLUGIN_PROVIDER_MEDIA_MODE=http
# DRAMA_PLUGIN_SERVICE_MEDIA_BASE_URL=http://127.0.0.1:8080
# DRAMA_PLUGIN_SERVICE_MEDIA_API_TOKEN=change-me
# Colon-separated on macOS/Linux. Every file:// import is canonicalized and
# must resolve below one of these roots.
# DRAMA_PLUGIN_MEDIA_IMPORT_ALLOWED_ROOTS=/tmp/drama-import:/opt/drama/import
#
# Operation paths are not environment variables. Start from:
# config/drama-service-http.example.yaml
