# 剧情节奏策略，由 Plugin 上下文层读取；work_defined / slow / medium / fast，省略使用 work_defined，勿留空。
rhythm_speed=work_defined
# 音视频语义观察 Provider 开关；off 禁用，省略用默认值，显式空值属于配置错误。
DRAMA_PLUGIN_PROVIDER_AUDIO_SEMANTIC_MODE=off
# 通义音视频观察 API 密钥，由观察适配器鉴权时使用；启用观察时必填，留空表示未配置。
DRAMA_PLUGIN_PROVIDER_QWEN_OMNI_API_KEY=
# 通义音视频观察官方服务地址，由观察适配器发送请求时使用；启用观察时必填，留空不能调用。
DRAMA_PLUGIN_PROVIDER_QWEN_OMNI_BASE_URL=
# 通义观察模型名称，由已有音视频观察适配器使用；可选，省略使用内置默认值，非本轮视频生成模型。
DRAMA_PLUGIN_PROVIDER_QWEN_OMNI_MODEL=qwen3.8-omni-flash
# 通义观察推理强度，由音视频观察请求使用；可选，none 表示不开启额外推理，省略使用默认值。
DRAMA_PLUGIN_PROVIDER_QWEN_OMNI_REASONING_EFFORT=none
# 多声道观察开关，由音视频语义观察使用；可选，false 关闭，省略使用默认值。
DRAMA_PLUGIN_PROVIDER_QWEN_OMNI_USE_MULTICHANNEL=false
# 媒体本地导入允许目录，由 Plugin 导入文件时检查；可选，留空禁止本地文件导入；远程 HTTPS 导入仍需独立安全校验。
DRAMA_PLUGIN_MEDIA_IMPORT_ALLOWED_ROOTS=
# 角色配音临时输出目录，由配音适配器保存合成音频时使用；启用配音时必填，留空无法落盘。
DRAMA_PLUGIN_ROLE_DUBBING_OUTPUT_DIRECTORY=
# 配音请求超时秒数，由配音适配器调用时使用；可选，省略使用内置默认值，留空不是零秒。
DRAMA_PLUGIN_ROLE_DUBBING_TIMEOUT_SECONDS=60
# Fish Audio 配音密钥，由角色配音 Provider 鉴权使用；可选，留空禁用真实配音调用。
FISH_AUDIO_API_KEY=
# Fish Audio 官方服务地址，由配音 Provider 发起请求时使用；可选，省略使用内置地址，留空不提供可用地址。
FISH_AUDIO_BASE_URL=
# 现有 Fish 配音模型名称，由语音合成适配器使用；可选，省略使用默认模型，非视频生成模型配置。
FISH_TTS_MODEL=s2-pro
# 剧情存储 Provider 模式，由 Plugin 初始化时选择本地模拟或远程服务；可选，省略使用默认值，http 需配置对应地址和令牌。
DRAMA_PLUGIN_PROVIDER_MEMORY_MODE=mock
# 剧情存储服务地址，由对应 HTTP Provider 调用现有 Drama Service；http 模式必填，留空表示未配置远程地址。
DRAMA_PLUGIN_SERVICE_MEMORY_BASE_URL=
# 剧情存储服务访问令牌，由对应 HTTP Provider 鉴权使用；http 模式必填，留空不能调用，禁止提交到 Git。
DRAMA_PLUGIN_SERVICE_MEMORY_API_TOKEN=
# 剧情存储服务请求超时秒数，由对应 HTTP Provider 使用；可选，省略使用内置默认值，填写正数，勿留空。
DRAMA_PLUGIN_SERVICE_MEMORY_TIMEOUT_SECONDS=60
# 资产 Provider 模式，由 Plugin 初始化时选择本地模拟或远程服务；可选，省略使用默认值，http 需配置对应地址和令牌。
DRAMA_PLUGIN_PROVIDER_ASSET_MODE=mock
# 资产服务地址，由对应 HTTP Provider 调用现有 Drama Service；http 模式必填，留空表示未配置远程地址。
DRAMA_PLUGIN_SERVICE_ASSET_BASE_URL=
# 资产服务访问令牌，由对应 HTTP Provider 鉴权使用；http 模式必填，留空不能调用，禁止提交到 Git。
DRAMA_PLUGIN_SERVICE_ASSET_API_TOKEN=
# 资产服务请求超时秒数，由对应 HTTP Provider 使用；可选，省略使用内置默认值，填写正数，勿留空。
DRAMA_PLUGIN_SERVICE_ASSET_TIMEOUT_SECONDS=60
# 研究 Provider 模式，由 Plugin 初始化时选择本地模拟或远程服务；可选，省略使用默认值，http 需配置对应地址和令牌。
DRAMA_PLUGIN_PROVIDER_RESEARCH_MODE=mock
# 研究服务地址，由对应 HTTP Provider 调用现有 Drama Service；http 模式必填，留空表示未配置远程地址。
DRAMA_PLUGIN_SERVICE_RESEARCH_BASE_URL=
# 研究服务访问令牌，由对应 HTTP Provider 鉴权使用；http 模式必填，留空不能调用，禁止提交到 Git。
DRAMA_PLUGIN_SERVICE_RESEARCH_API_TOKEN=
# 研究服务请求超时秒数，由对应 HTTP Provider 使用；可选，省略使用内置默认值，填写正数，勿留空。
DRAMA_PLUGIN_SERVICE_RESEARCH_TIMEOUT_SECONDS=60
# 媒体 Provider 模式，由 Plugin 初始化时选择本地模拟或远程服务；可选，省略使用默认值，http 需配置对应地址和令牌。
DRAMA_PLUGIN_PROVIDER_MEDIA_MODE=mock
# 媒体服务地址，由对应 HTTP Provider 调用现有 Drama Service；http 模式必填，留空表示未配置远程地址。
DRAMA_PLUGIN_SERVICE_MEDIA_BASE_URL=
# 媒体服务访问令牌，由对应 HTTP Provider 鉴权使用；http 模式必填，留空不能调用，禁止提交到 Git。
DRAMA_PLUGIN_SERVICE_MEDIA_API_TOKEN=
# 媒体服务请求超时秒数，由对应 HTTP Provider 使用；可选，省略使用内置默认值，填写正数，勿留空。
DRAMA_PLUGIN_SERVICE_MEDIA_TIMEOUT_SECONDS=60
# 上下文 Provider 模式，由 Plugin 初始化时选择本地模拟或远程服务；可选，省略使用默认值，http 需配置对应地址和令牌。
DRAMA_PLUGIN_PROVIDER_CONTEXT_MODE=local
# 上下文服务地址，由对应 HTTP Provider 调用现有 Drama Service；http 模式必填，留空表示未配置远程地址。
DRAMA_PLUGIN_SERVICE_CONTEXT_BASE_URL=
# 上下文服务访问令牌，由对应 HTTP Provider 鉴权使用；http 模式必填，留空不能调用，禁止提交到 Git。
DRAMA_PLUGIN_SERVICE_CONTEXT_API_TOKEN=
# 上下文服务请求超时秒数，由对应 HTTP Provider 使用；可选，省略使用内置默认值，填写正数，勿留空。
DRAMA_PLUGIN_SERVICE_CONTEXT_TIMEOUT_SECONDS=60
# 声音身份 Provider 模式，由 Plugin 初始化时选择本地模拟或远程服务；可选，省略使用默认值，http 需配置对应地址和令牌。
DRAMA_PLUGIN_PROVIDER_VOICE_MODE=mock
# 声音身份服务地址，由对应 HTTP Provider 调用现有 Drama Service；http 模式必填，留空表示未配置远程地址。
DRAMA_PLUGIN_SERVICE_VOICE_BASE_URL=
# 声音身份服务访问令牌，由对应 HTTP Provider 鉴权使用；http 模式必填，留空不能调用，禁止提交到 Git。
DRAMA_PLUGIN_SERVICE_VOICE_API_TOKEN=
# 声音身份服务请求超时秒数，由对应 HTTP Provider 使用；可选，省略使用内置默认值，填写正数，勿留空。
DRAMA_PLUGIN_SERVICE_VOICE_TIMEOUT_SECONDS=60
# Seedance 官方视频 API 密钥，由视频 HTTP Provider 鉴权时使用；可选，留空仅禁用该 Provider，不影响 Plugin 启动。
DRAMA_VIDEO_SEEDANCE_API_KEY=
# Seedance 官方视频 API 基础地址，由视频 HTTP Provider 按账号区域调用；启用时必填，留空仅禁用该 Provider。省略变量时可使用内置默认地址。
DRAMA_VIDEO_SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# MiniMax 官方视频 API 密钥，由视频 HTTP Provider 鉴权时使用；可选，留空仅禁用该 Provider，不影响 Plugin 启动。
DRAMA_VIDEO_MINIMAX_API_KEY=
# MiniMax 官方视频 API 基础地址，由视频 HTTP Provider 按账号区域调用；启用时必填，留空仅禁用该 Provider。省略变量时可使用内置默认地址。
DRAMA_VIDEO_MINIMAX_BASE_URL=https://api.minimaxi.com
# Vidu 官方视频 API 密钥，由视频 HTTP Provider 鉴权时使用；可选，留空仅禁用该 Provider，不影响 Plugin 启动。
DRAMA_VIDEO_VIDU_API_KEY=
# Vidu 官方视频 API 基础地址，由视频 HTTP Provider 按账号区域调用；启用时必填，留空仅禁用该 Provider。省略变量时可使用内置默认地址。
DRAMA_VIDEO_VIDU_BASE_URL=https://api.vidu.com
# Wan 官方视频 API 密钥，由视频 HTTP Provider 鉴权时使用；可选，留空仅禁用该 Provider，不影响 Plugin 启动。
DRAMA_VIDEO_WAN_API_KEY=
# Wan 官方视频 API 基础地址，由视频 HTTP Provider 按账号区域调用；启用时必填，留空仅禁用该 Provider。Wan 需包含正确 Workspace、Region 和 /api/v1。
DRAMA_VIDEO_WAN_BASE_URL=
# Kling 官方视频 API 密钥，由视频 HTTP Provider 鉴权时使用；可选，留空仅禁用该 Provider，不影响 Plugin 启动。
DRAMA_VIDEO_KLING_API_KEY=
# Kling 官方视频 API 基础地址，由视频 HTTP Provider 按账号区域调用；启用时必填，留空仅禁用该 Provider。Kling 必须使用当前官方文档的服务地址。
DRAMA_VIDEO_KLING_BASE_URL=

# flux-3 视频模型启用开关，由路线选择与新任务提交门禁读取；true 才允许候选，false、空值或非法值禁用；可选，省略沿用 true；不影响已提交任务的查询回收。
DRAMA_VIDEO_MODEL_FLUX_3_ENABLED=true

# kling-3 视频模型启用开关，由路线选择与新任务提交门禁读取；true 才允许候选，false、空值或非法值禁用；可选，省略沿用 true；不影响已提交任务的查询回收。
