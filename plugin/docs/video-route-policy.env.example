# Plugin-owned. Default behavior remains AUTO. Copy deliberately; never auto-apply.
# 已有视频路线偏好模式，由路线选择器读取；可选，auto 自动比较，prefer 按偏好尝试，pin 锁定；留空等同 auto。
DRAMA_PLUGIN_VIDEO_ROUTE_MODE=auto
# 已有路线兼容偏好键，由选择器在 prefer 或 pin 时使用；auto 可留空，能力与正式模型 ID 仍由 Registry 管理。
DRAMA_PLUGIN_VIDEO_MODEL_PREFERRED=
# 已有路线兼容回退键列表，由 prefer 模式按逗号顺序读取；可选，留空无指定回退，pin 时不生效。
DRAMA_PLUGIN_VIDEO_MODEL_FALLBACKS=

# Daily preference example (explicit permitted fallback order):
# DRAMA_PLUGIN_VIDEO_ROUTE_MODE=prefer
# DRAMA_PLUGIN_VIDEO_MODEL_PREFERRED=seedance-2.5
# DRAMA_PLUGIN_VIDEO_MODEL_FALLBACKS=minimax-h3,flux-3

# Controlled Seedance comparison: no silent fallback.
# DRAMA_PLUGIN_VIDEO_ROUTE_MODE=pin
# DRAMA_PLUGIN_VIDEO_MODEL_PREFERRED=seedance-2.5
# Stored fallbacks are INACTIVE in PIN.
