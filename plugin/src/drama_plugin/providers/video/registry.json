      ]
    },
    "minimax": {
      "transport": "http",
      "base_url": "https://api.minimaxi.com",
      "hosts": [
        "api.minimaxi.com",
        "api.minimax.io"
      ],
      "create": "/v2/video_generation",
      "poll": "/v2/query/video_generation/{id}",
      "auth": "Bearer",
      "docs": [
        "https://platform.minimax.io/docs/api-reference/video-generation-v2-create",
        "https://platform.minimax.io/docs/api-reference/video-generation-v2-query"
      ]
    },
    "vidu": {
      "transport": "http",
      "base_url": "https://api.vidu.com",
      "hosts": [
        "api.vidu.com"
      ],
      "create": {
        "text_to_video": "/ent/v2/text2video",
        "image_to_video": "/ent/v2/img2video",
        "first_last_frame": "/ent/v2/start-end2video",
        "reference": "/ent/v2/reference2video"
      },
      "poll": "/ent/v2/tasks/{id}/creations",
      "auth": "Token",
      "docs": [
        "https://platform.vidu.com/docs/text-to-video",
        "https://platform.vidu.com/docs/image-to-video",
        "https://platform.vidu.com/docs/start-end-to-video",
        "https://platform.vidu.com/docs/reference-to-video"
      ]
    },
    "wan": {
      "transport": "http",
      "base_url": "",
      "hosts": [],
      "host_pattern": "[a-zA-Z0-9-]+\\.(ap-southeast-1|cn-beijing|us-east-1|ap-northeast-1|eu-central-1|cn-hongkong)\\.maas\\.aliyuncs\\.com",
      "create": "/services/aigc/video-generation/video-synthesis",
      "poll": "/tasks/{id}",
      "auth": "Bearer",
      "docs": [
        "https://www.alibabacloud.com/help/en/model-studio/wan3-video-generation-api-reference"
      ]
    },
    "kling": {
      "transport": "http",
      "base_url": "",
      "hosts": [
        "api-singapore.klingai.com"
      ],
      "create": {
        "text_to_video": "/text-to-video/{model}",
        "image_to_video": "/image-to-video/{model}",
        "first_last_frame": "/image-to-video/{model}",
        "reference": "/omni-video/{model}",
        "edit": "/omni-video/{model}",
        "motion_transfer": "/motion-control/{model}"
      },
      "poll": "/tasks",
      "auth": "Bearer",
      "recover_external": true,
      "role": [
        "specialist"
      ],
      "docs": [
        "https://kling.ai/document-api/api/video/3-0-omni/text-to-video",
        "https://kling.ai/document-api/api/video/3-0-omni/image-to-video",
        "https://kling.ai/document-api/api/video/3-0-omni/video-omni",
        "https://kling.ai/document-api/api/video/3-0-omni/motion-control",
        "https://kling.ai/document-api/api/video/3-0-turbo/image-to-video"
      ]
    },
