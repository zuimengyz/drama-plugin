      "source": {
        "id": "S01",
        "content": {
          "revisionId": "F01-R2-CANDIDATE",
          "screenplayAction": "三个人围着桌子说话。茶已经冷了。\n工程师把一张纸移到桌中央。朋友刚要开口，他便用指头压住纸上的一个地方。\n另一个朋友笑。两个人越说越快，话挤在一处。坐在旁边的男人始终没碰自己的杯子。他的衣袖蹭到杯柄，扶正，却没看桌上那张纸。\n男人看向他。又看向另一个人。桌上的话停下来，他才开口。\n男人没回答。他把杯子往桌里推，起身去取外衣。\n朋友笑出声。工程师也笑了，把纸收回来，继续刚才的争论。没有人赶男人走。\n男人穿错了一个袖口。他重新穿。朋友替他推开挡路的椅子，他等椅子让开便出去，没有道谢，也没有表示不满。\n楼梯上传来房间里的笑声。他停住，回头听。屋里又争起那张纸上的事，没有人叫他。\n他继续往下走。",
          "spokenContent": [
            {
              "id": "S01-L1",
              "speakerKey": "工程师",
              "target": "朋友",
              "text": "你得先承认这一点。",
              "intent": "要求对方先承认纸上的论点",
              "performanceIntent": "争论中坚持先决条件，话短而顶住对方",
              "mustKeep": true
            },
            {
              "id": "S01-L2",
              "speakerKey": "朋友",
              "target": "工程师",
              "text": "我为什么得先承认？",
              "intent": "拒绝接受对方设定的先决条件",
              "performanceIntent": "紧接对方反问，没有向观众说明理论",
              "mustKeep": true
            },
            {
              "id": "S01-L3",
              "speakerKey": "工程师",
              "target": "男人",
              "text": "你呢？你听了半天。",
              "intent": "要求旁听的男人表态",
              "performanceIntent": "点名等答，不带审判或恶意",
              "mustKeep": true
            },
            {
              "id": "S01-L4",
              "speakerKey": "男人",
              "target": "桌边朋友",
              "text": "你们其实都不在乎。",
              "intent": "否定争论以结束自己的参与",
              "performanceIntent": "平直地说，不咆哮，不解释自己的世界观",
              "mustKeep": true
            },
            {
              "id": "S01-L5",
              "speakerKey": "朋友",
              "target": "男人",
              "text": "你倒在乎什么？",
              "intent": "反问男人究竟在乎什么",
              "performanceIntent": "接住他的断言往回问，等待回答",
              "mustKeep": true
            }
          ]
        }
      },
