    {
      "name": "HeyGenTalkingPhotoNode",
      "display_name": "HeyGen Talking Photo",
      "description": "Animate any image of a person into a lip-synced talking video (HeyGen Avatar IV). Drive it with a text script or your own audio.",
      "category": "partner/video/HeyGen",
      "pack": "core",
      "inputs": {
        "required": [
          "IMAGE",
          "COMFY_DYNAMICCOMBO_V3",
          "STRING",
          "COMBO",
          "STRING",
          "FLOAT",
          "AUDIO"
        ],
        "optional": [
          "COMBO",
          "COMBO",
          "COMBO",
          "INT"
        ]
      },
      "input_details": [
        {
          "name": "image",
          "type": "IMAGE",
          "required": true,
          "tooltip": "Image of a person to animate. Downscaled automatically if larger than 2K."
        },
        {
          "name": "speech",
          "type": "COMFY_DYNAMICCOMBO_V3",
          "required": true,
          "dynamic_combo": true,
          "options": [
            "script",
            "audio"
          ],
          "tooltip": "Drive the avatar with a text script (HeyGen text-to-speech) or your own audio.",
          "hint": "Dynamic combo: pick one `options` value for `speech`, then send each conditional sub-field below using its full dotted name (prefixed with `speech.`, e.g. `speech.<sub_field>`). Auto-grow list slots nest one level deeper (e.g. `speech.<list>.<slot_1>`). Sending these fields flat (without the prefix) fails with required_input_missing."
        },
        {
          "name": "speech.text",
          "type": "STRING",
          "required": true,
          "conditional": true,
          "applies_when": [
            "script"
